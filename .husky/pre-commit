#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# 0. Git Health check
echo "→ Git Health check..."
npm run health:git || { echo "❌ Git health check failed"; exit 1; }

# 1. TypeScript check
echo "→ TypeScript..."
npx tsc --noEmit || { echo "❌ TypeScript failed"; exit 1; }

# 2. Lint staged files
echo "→ ESLint (staged files only)..."
npx lint-staged || { echo "❌ Lint failed"; exit 1; }

# 3. Run tests
echo "→ Running tests..."
npx vitest run --reporter=dot || { echo "❌ Tests failed"; exit 1; }

# 4. Architecture audit
echo "→ Architecture audit..."
npm run audit:arch > /dev/null 2>&1 || { echo "⚠️  Architecture audit failed (non-blocking for now)"; }

echo "✅ All pre-commit checks passed."
exit 0
