{
  "name": "fox-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src/ --max-warnings 500",
    "lint:strict": "eslint src/ --max-warnings 0",
    "audit:arch": "node scripts/audit-architecture.mjs",
    "health:git": "node scripts/git-health-check.mjs",
    "audit:all": "npm run audit:arch && npm run health:git",
    "audit:deps": "depcruise --config .dependency-cruiser.js src/",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "feature:new": "node scripts/new-feature.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepare": "husky",
    "pre-commit:verify": "npx tsc --noEmit && npm run typecheck:functions && npm run lint && npx vitest run --run && npm run audit:arch"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@iconify/react": "^6.0.2",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@sentry/react": "^10.74.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "iconsax-react": "^0.0.8",
    "immer": "^11.1.18",
    "motion": "^13.4.4",
    "nanoid": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}