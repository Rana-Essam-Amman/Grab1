VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Server-side only (Cloudflare Pages Functions env in production,
# or .env.local for `wrangler pages dev` / local function testing).
# Do NOT prefix with VITE_ — it must never be bundled into the client.
GEMINI_API_KEY=your-gemini-api-key-here

# Paddle (Merchant of Record) — client-side checkout token.
# Get from https://vendors.paddle.com/authentication
# If empty → MockPaymentAdapter is used instead (dev only).
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_MAP={}

# Sentry (error monitoring). If empty, Sentry runs in no-op mode and
# the client never sends events. Get DSN from https://sentry.io →
# project settings → client keys (DSN).
VITE_SENTRY_DSN=

# PostHog (product analytics). If empty, analytics runs in no-op mode and
# the client never sends events. Get Project API Key from PostHog settings.
# Host defaults to EU: https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Build version label. Surfaces in error_logs and Sentry releases.
# Set this to the git short SHA at deploy time (e.g. Cloudflare Pages
# build command: VITE_APP_VERSION=$CF_PAGES_COMMIT_SHA).
VITE_APP_VERSION=

# Demo mode — brings static seed listings back into the store.
# OFF in production (default when unset). ON in Cloudflare preview.
# Can also be activated per-session via ?demo=1 in the URL.
# VITE_DEMO_MODE=true
